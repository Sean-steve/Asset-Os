{
  "name": "@asset-os/api",
  "version": "0.3.0-b2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "npm run build && node dist/migrate.js",
    "migrate:check": "npm run build && node dist/migrate.js --check",
    "test": "npm run build && node --test test/*.unit.test.mjs",
    "test:db": "npm run build && node --test test/*.db.test.mjs",
    "bootstrap": "npm run build && node dist/bootstrap.js"
  },
  "dependencies": {
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "zod": "4.1.6",
    "jose": "6.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
