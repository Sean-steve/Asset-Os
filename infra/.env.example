# Copy this to infra/.env; do not commit it.
# Development-only credentials. Use separate secret-managed credentials in production.
ASSET_OS_OWNER_PASSWORD=change-local-owner-password
ASSET_OS_APP_PASSWORD=change-local-runtime-password
ASSET_OS_API_PORT=3001
ASSET_OS_PG_PORT=5435

# Optional B1 trusted identity provider; ALL THREE must be set to enable domain routes.
# HTTPS issuer and JWKS on the same origin, RS256 access tokens for the Asset OS audience.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
